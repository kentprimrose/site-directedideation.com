# EXAMPLE ONLY — not activated. Include in http context only after the deployment gate.
# Assumes nginx is the direct outermost peer: do not enable real_ip rewriting.
# Shared IPs share these conservative limits; tune only after staging tests.
limit_req_zone $binary_remote_addr zone=staging_mcp_req:10m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=staging_mcp_conn:10m;

server {
    listen 0.0.0.0:443 ssl;
    # IPv4 only: revisit IPv6 identity and prefix limiting before enabling it.
    server_name mcp-staging.directedideation.com;

    # Certificates are provisioned and renewed externally by Certbot, not nginx.
    ssl_certificate /etc/letsencrypt/live/mcp-staging.directedideation.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp-staging.directedideation.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 64k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;
    keepalive_timeout 15s;
    limit_req zone=staging_mcp_req burst=20 nodelay;
    limit_req_status 429;
    limit_req_log_level warn;
    limit_conn staging_mcp_conn 4;
    limit_conn_status 429;
    limit_conn_log_level warn;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        # Preserve bearer authentication even if inherited proxy settings differ.
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
